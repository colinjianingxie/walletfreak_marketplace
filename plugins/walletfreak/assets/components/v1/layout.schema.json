{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://walletfreak.com/components/v1/layout.schema.json",
  "title": "WalletFreak layout v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "theme",
    "density",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "theme": {
      "enum": [
        "paper",
        "sage",
        "midnight"
      ]
    },
    "density": {
      "enum": [
        "compact",
        "comfortable"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "source",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "component": {
            "enum": [
              "metric-cards",
              "data-table",
              "reference-list",
              "findings",
              "itinerary",
              "wallet-cards"
            ]
          },
          "source": {
            "enum": [
              "spending.metrics",
              "wallet.cards",
              "wallet.programs",
              "wallet.benefits",
              "spending.references",
              "spending.findings",
              "travel.itinerary"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "component": {
                  "const": "metric-cards"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "spending.metrics"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "component": {
                  "const": "data-table"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "wallet.cards",
                    "wallet.programs",
                    "wallet.benefits"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "component": {
                  "const": "reference-list"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "spending.references"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "component": {
                  "const": "findings"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "spending.findings"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "component": {
                  "const": "itinerary"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "travel.itinerary"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "component": {
                  "const": "wallet-cards"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "wallet.cards"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
